\begin{frame}
  \frametitle{Three possible outcomes after a new disease invades}

  \setbeamertemplate{description item}{%
    \makebox[2.5cm][l]{\insertdescriptionitem}%
  }

  \begin{description}[\bfseries Persistence]\itemsep12pt
    \item[\bfseries Fizzle] stochastic extinction before a major epidemic.
    \pause
    \item[\bfseries Burnout] stochastic extinction after a major epidemic, near the
      post-epidemic trough.
    \pause
    \item[\bfseries Persistence] the pathogen escapes both events and produces later
      epidemic waves.
  \end{description}

  \vspace{1.2em}
  In a finite population stochastic model, eventual extinction is certain\pause:
    \term{persistence} means survival past the first major trough.
\end{frame}

\section{The SIR model}

\begin{frame}
  \frametitle{Susceptible-Infectious-Removed (SIR) model
    \quad \parbox{10ex}{\raggedright\tiny\color{cyan} Kermack and McKendrick (1927)}
  }

  %%\leftline{\tiny\color{cyan} Kermack and McKendrick 1927 (KM27)}

  \pause
  \begin{center}
  %%\includegraphics[width=0.9\textwidth]{flowcharts/flowrates.pdf}
  %%\includegraphics[width=0.9\textwidth]{images/SIR_flow_colour.pdf}
  %%\includegraphics[width=\textwidth]{images/SIRflowchart_nogreek.png}
  \includegraphics[width=0.8\textwidth]{sir_flowchart.png}
  \end{center}

  \vspace{-1cm}
  \pause
  %%\makebox[\textwidth][c]{%
  %%Ordinary differential equations (ODEs):
  \begin{alignat*}{3}
    \text{\color{beamerblue}ODEs:} \quad
    \ddt{S} \;&=\; - \beta \frac{S I}{n}           \qquad\quad&
    \ddt{I} \;&=\; \beta \frac{S I}{n} - \gamma I  \qquad\quad&
    \ddt{R} \;&=\; \gamma I \\
  \noalign{\vspace{5pt}}
    S(\tinit) \;&=\; \sinit&
    I(\tinit) \;&=\; \iinit&
    R(\tinit) \;&=\; \rinit
  \end{alignat*}
  \pause
  \emphblue{Population size:} \qquad $n \;=\; S(t)+I(t)+R(t) \;=\; \text{constant}$

  \bigskip
  \pause
  \footnotesize
  \emphblue{Notational convention:}
  \tiny
  \begin{itemize}
    \pause\item UPPER CASE (\eg $S$, $I$) $\implies$ functions
    \pause\item lower case (\eg $t$, $\sinit$, $\iinit$) $\implies$
    independent variables and values of functions at specific points
  \end{itemize}
  \normalsize

  \medskip
  \pause
  \emphblue{Parameters:}
  \begin{itemize}
  \pause\item
  {Transmission rate:} \ $\beta$
  \pause\item
  {Recovery rate:} \ $\gamma$
  \pause \qquad\qquad
  ($\frac{1}{\gamma} = \text{mean infectious period}$)
  \end{itemize}

\end{frame}

\begin{frame}
  \frametitle{\textbf{SIR model:} in dimensionless, proportional form}

  \small
  \begin{itemize}\itemsep3pt
    \pause\item Total population: $\Npop = S + I + R$

    \pause\item State variables:
    \begin{itemize}\itemsep3pt
      \pause\item \emphblue{Susceptible fraction:} \ \ \ $X = S/\Npop$
      \pause\item \emphblue{Prevalence of infection:}  \ $Y = I/\Npop$
    \end{itemize}

  \pause\item Dimensionless parameter: \emphblue{Basic reproduction number:} \;$\Rn = \dfrac{\beta}{\gamma}$

  \pause
  $\Big(\parbox{10ex}{\centering\scriptsize transmission rate}\Big)
  \times \Big(\parbox{8ex}{\centering\scriptsize mean infectious period}\Big)
  \pause = \; \Big(\parbox{31ex}{\centering\scriptsize number of infections expected to be caused by a single infectious individual in a wholly susceptible population}\Big)$

  \pause\item Dimensionless time unit:
  \begin{itemize}
  \pause\item
  \emphblue{Time in units of mean infectious period:} \ $\tau = \gamma t$
  \end{itemize}

  \end{itemize}

  \pause
  \begin{equation*}
    \begin{aligned}
      \ddtau{X} &\;=\; - \Rn X Y,        & \qquad X(\tauinit) \;=\; \xinit \\
      \noalign{\vspace{5pt}}
      \ddtau{Y} &\;=\; (\Rn X  - 1) Y,   & \qquad Y(\tauinit) \;=\; \yinit
    \end{aligned}
  \end{equation*}

  \begin{itemize}
    \pause\item \emphblue{Peak prevalence:} \ $\ypeak\equiv\max Y(\tau)$ \
    occurs when \ $X(\tau)=\xpeak\equiv\dfrac{1}{\Rn}$
  \end{itemize}

  \only<.>{\hypertarget{eq:SIR}{}}

\end{frame}

\begin{frame}
  \frametitle{\textbf{SIR model:} Typical (numerical) solution\hfill\break for susceptibles $X(\tau)$ and prevalence of infection $Y(\tau)$}

  \begin{center}

    \includegraphics[width=\textwidth]{mbrs_sir_timeseries.pdf}

    \bigskip
    Time $\tau$ measured in units of mean infectious period ($\frac{1}{\gamma}$)

  \end{center}

  \hypertarget{sir.short}{}
\end{frame}

\begin{frame}
  \frametitle{\textbf{SIR model:} \ $x$-$y$ phase plane}

  \begin{itemize}\itemsep10pt

    \pause\item No closed-form analytical solution of
    \myhyperlink{eq:SIR}{SIR model} for
    %% time series of
    susceptible proportion $X(\tau)$ and prevalence of infection
    $Y(\tau)$

    \pause\item But the \emphblue{exact solution in $x$-$y$ phase plane} is easily found:

    \smallskip
    \begin{itemize}

      \pause\item Consider \emphblue{ratio of rates} of change of $Y$ and $X$:
      \pause
      \begin{equation*}
        \frac{\dee Y / \dee\tau}{\dee X/\dee\tau}
        \pause \;=\; \frac{\Rn X Y - Y}{-\Rn X Y}
        \pause \;=\; -1 + \frac{1}{\Rn X}
      \end{equation*}

      \pause\item Obtain simple \emphblue{separable ODE} for $Y(x)$:
      \begin{equation*}
        \ddx{Y} \;=\; -1 + \frac{\xpeak}{x} \,,
        \qquad Y(\xinit) \;=\; \yinit
      \end{equation*}
      \pause
      {\footnotesize\hfill
\        ($\xpeak \,=\, \frac{1}{\Rn} \,=\, X(\tau)\text{ at peak prevalence}$)}

      \bigskip
      \pause\item \emphblue{Exact solution for phase portrait} is
      \begin{equation*}
        Y(x) \;=\; \yinit + (\xinit - x) - \xpeak\log{\frac{\xinit}{x}}
      \end{equation*}

    \end{itemize}
  \end{itemize}
  \frameendtarget{eq:dYdx}
  \frameendtarget{eq:Yofx}
\end{frame}

\begin{frame}
  \frametitle{\textbf{SIR model:} \ Exact $x$-$y$ phase portrait \,$Y(x)$}

  \begin{center}
    \includegraphics[width=0.6\textwidth]{mbrs_sir_phase_portrait.pdf}
  \end{center}

  \begin{itemize}
    \pause\item Final susceptible proportion $\bullet$ is smaller for larger $\Rn$
    \pause\item Larger $\Rn$ $\implies$ all $\bullet$ move left
  \end{itemize}

  \hypertarget{fig:pp}{}

\end{frame}

\begin{frame}
  \frametitle{\textbf{SIR With Vital Dynamics\\(DETERMINISTIC)}}

  \bigskip
  With \term{vital dynamics} (births and deaths) at \emph{per capita} rate $\redmu$\\
  there are additional terms in the equations.  \pause In terms of counts: \pause
  \begin{equation*}\label{eq:sir-counts}
  \begin{aligned}
    \qquad
    \ddt{S} \;=\; \redmu n - \beta\frac{S I}{n} - \redmu S, %\\[5pt]
    \qquad\quad
  \ddt{I} \;=\; \beta\frac{S I}{n} -(\gamma+\redmu)I %,\\[5pt]
  %%\ddt{R} \;=\; \gamma I - \redmu R.
  \end{aligned}
  \end{equation*}
  \pause In terms of proportions\pause, with dimensionless time
  $\tau=(\gamma+\redmu)t$,\pause
  \begin{equation*}\label{eq:sir-proportion-odes}
  \begin{aligned}
  \ddtau{X}\;=\;\redeps(1-X)-\Rn XY,
  \qquad
  \ddtau{Y}\;=\;(\Rn X-1)Y.
  \end{aligned}
  \end{equation*}
  \pause
  \emphblue{Dimensionless parameters:}
  \begin{equation*}\label{eq:R0-eps-defs}
  \Rn\;=\;\frac{\beta}{\gamma+\redmu},
  \qquad
  \redeps\;=\;\frac{\redmu}{\gamma+\redmu}
  \;=\;
  \frac{\text{\small mean infectious period}}{\text{\small mean lifetime}}
  \; {\color{red} \sim\; 0.001}
  \end{equation*}
  %%\pause
  %%For acute human infections, $\color{red}\redeps \sim 0.001$.
  \pause
  \emphblue{Damped oscillations onto \term{endemic equilirium}:}
  \begin{equation*}\label{eq:sir-endemic-equilibrium}
  (\xstar,\ystar)
  \;=\;
  \left(\frac{1}{\Rn}, \;\redeps\Big(1-\frac{1}{\Rn}\Big)\right)
  \end{equation*}
\end{frame}

\begin{frame}
  \frametitle{\textbf{Deterministic trajectories with vital dynamics}}

  \bigskip
  \centering
  \includegraphics[width=\textwidth]{deterministic_sir_trajectory.pdf}

\end{frame}

\begin{frame}
  \frametitle{\bfseries Deterministic epidemic trough depth -- intuition}

  \begin{columns}[T,onlytextwidth]
    \begin{column}{0.45\textwidth}
      Without vital dynamics, the \term{final size} \pause (total proportion infected during the epidemic)
      %% (cumulative infected proportion)
      grows monotonically with \(\Rn\)\pause,
      and very low prevalence is reached quickly.

      \pause
      \medskip

      \centering
      \includegraphics[
        width=0.95\textwidth,
        height=0.55\textheight,
        keepaspectratio
      ]{code/finalsize.pdf}
    \end{column}

    \begin{column}{0.47\textwidth}
      \pause
      \pmb{$\therefore$} With vital dynamics, inter-epidemic troughs are
      expected to be deeper (lower prevalence) for larger \(\Rn\).

      \pause
      \bigskip

      \pmb{$\therefore$} We expect persistence to be less likely for
      larger $\Rn$.

      \pause
      \bigskip

      In fact, the prevalence trough gets deeper for $\Rn$ from 1 to
      $\approx2.5$, but then gets
      \emph{\color{beamerblue}\underline{shallower}} for higher $\Rn$.

      \pause
      \bigskip

      $\implies$ \emphblue{The relationship between transmissibility and
      \emph{\underline{persistence}} is not monotone.}
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}
  \frametitle{\bfseries Deterministic epidemic trough depth -- reality}
  %%The Dangerous Trough

  \begin{columns}[T,onlytextwidth]
    \begin{column}{0.49\textwidth}
      \centering

      %%Prevalence $Y$ as a function\\of time $\tau$ for fixed basic reproduction number $\Rn$
      Prevalence $Y$ \emph{vs.}\ time $\tau$\\ for fixed $\Rn$
      
      %%\includegraphics[width=\textwidth,height=0.68\textheight,keepaspectratio]{sir_trough_slow_infectious_period.pdf}
      \includegraphics[width=\textwidth,height=0.68\textheight,keepaspectratio]{sir_trough_depth_time_series.pdf}

      %%Longer infectious period
      {\color{beamerblue}\textbf{shallower} for \textbf{larger} $\Rn$}
    \end{column}
    \pause
    \begin{column}{0.49\textwidth}
      \centering

      %%Minimum prevalence $\ymin$\\as a function of $\Rn$ for\\fixed mean infectious period $\Tinf$
      %%Minimum prevalence $\ymin$\\\emph{vs.}\ $\Rn$ for fixed $\Tinf$
      $\min{Y(\tau)}$ \emph{vs.}\ $\Rn$\\for fixed $\Tinf$

      %%\includegraphics[width=\textwidth,height=0.68\textheight,keepaspectratio]{sir_trough_fast_infectious_period.pdf}
      \includegraphics[width=\textwidth,height=0.68\textheight,keepaspectratio]{sir_trough_depth_vs_R0.pdf}

      %%Shorter infectious period
      {\color{beamerblue}\textbf{shallower} for \textbf{longer} $\Tinf$}
    \end{column}
  \end{columns}

  %% \vspace{0.3em}
  %% Susceptible recruitment helps, but the depth and timing of the trough
  %% determine the extinction risk.
\end{frame}

\begin{frame}
  %%\frametitle{Individual-Based Stochastic SIR}
  \frametitle{\textbf{SIR With Vital Dynamics\\(STOCHASTIC, INDIVDIUAL-BASED)}}

  Same model interpreted as a continuous-time Markov chain:
  \begin{center}
  \small
  \begin{tabular}{lll}
    Event & Jump & Rate\\
    \hline
    Infection & \((S,I,R)\to(S-1,I+1,R)\) &
      \(\beta S I/\Npop\)\\
    Recovery & \((S,I,R)\to(S,I-1,R+1)\) &
      \(\gamma I\)\\
    Death, susceptible & \((S,I,R)\to(S,I,R)\) &
      \(\redmu S\)\\
    Death, infectious & \((S,I,R)\to(S+1,I-1,R)\) &
      \(\redmu I\)\\
    Death, removed & \((S,I,R)\to(S+1,I,R-1)\) &
      \(\redmu R\)
  \end{tabular}
  \end{center}

  \begin{itemize}\itemsep\medskipamount
  \pause\item
  \(I(t)=n\,Y(t)\) \,is the \emphblue{expected number} of infectious individuals.

  \pause\item
  States are discrete counts\pause, so extinction is a \emphblue{boundary event}.

  \pause\item
  Deterministic geometry still matters\pause, but \emphblue{stochastic treatment is required when few individuals are infected}.

  \end{itemize}

\end{frame}

\begin{frame}
  \frametitle{\textbf{Stochastic Trajectories Can Hit the Boundary}}

  \begin{columns}[c,onlytextwidth]
    \begin{column}{0.55\textwidth}
      \centerline{\bfseries Time series}
      \includegraphics[height=0.7\textheight]{todd_stochastic_sir_trajectory.pdf}
    \end{column}
    \begin{column}{0.42\textwidth}
      \begin{itemize}
        \pause\item Deterministic trajectories have deep troughs (can be $<\frac1n$)
        \pause\item Stochastic trajectories can go extinct near deterministic trough
        \pause\item Identify boundary layer in which stochasticity dominates dynamics
        \pause\item Estimate susceptible proportion at entry to boundary layer ($\xin$) via perturbation analysis in phase plane
      \end{itemize}
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}
  \frametitle{\textbf{Stochastic Trajectories Can Hit the Boundary}}

  \begin{columns}[c,onlytextwidth]
    \begin{column}{0.55\textwidth}
      \centerline{\bfseries Time series}
      \includegraphics[height=0.7\textheight]{todd_stochastic_sir_trajectory.pdf}
    \end{column}
    \begin{column}{0.42\textwidth}
      \centerline{\bfseries Phase plane trajectory}
      \includegraphics[width=0.5\textheight]{fig_ts_pp_xy_d-top-label.pdf}
      \includegraphics[width=0.5\textheight]{fig_ts_pp_xy_e.pdf}

      \medskip\small
      Yellow dot (\!\includegraphics{fig_ts_pp_xy_de_yellow-dot.pdf}\!) indicates $(x,y)=(\xin,\ystarref)$, the point of entry into the boundary layer, where $y<\ystarref$
    \end{column}
  \end{columns}
\end{frame}

\section{Burnout Probability}

\begin{frame}
  \frametitle{\bfseries Hybrid Deterministic-Stochastic Approach}

  \begin{columns}[c,onlytextwidth]
    \begin{column}{0.42\textwidth}
      \centerline{\bfseries Phase plane trajectory}
      \includegraphics[width=0.5\textheight]{fig_ts_pp_xy_d-top-label.pdf}
      \includegraphics[width=0.5\textheight]{fig_ts_pp_xy_e.pdf}

      \medskip\small
      Yellow dot (\!\includegraphics{fig_ts_pp_xy_de_yellow-dot.pdf}\!) indicates $(x,y)=(\xin,\ystarref)$, the point of entry into the boundary layer, where $y<\ystarref$
    \end{column}
    \begin{column}{0.55\textwidth}
      \begin{enumerate}
        \pause\item Follow deterministic trajectory while infectious individuals are common.
        \pause\item Use matched asymptotics in the phase plane to approximate
        \footnotesize
        \begin{equation*}\label{eq:xin}
          \hspace*{-1.25em}
          \begin{aligned}
          {\color{red}\xin}
          &=
          e^{-\Rn(1-\ystarref)}
          + \epsref e^{\Rn\ystarref} \log\frac{\ystarref}{\ypeak}
          + \Oh(\epsref^2) \\
          {\color{red}\ypeak}
          &=
          1 - \frac{1}{\Rn}(1+\ln{\Rn}) + \Oh(\epsref^2)
          \end{aligned}
        \end{equation*}
        \rightline{\href{https://doi.org/10.1137/23M1576050}{\tiny Parsons \& Earn 2024, SIAP}}
        \normalsize
        \pause\item In the boundary layer, approximate infection dynamics by time-inhomogeneous birth-death process.
      \end{enumerate}
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}
  \frametitle{\bfseries Time-dependent birth-death process extinction}

  \footnotesize 
  \begin{theorem}[Kendall, 1948]\label{thm:Kendall}
    \begin{columns}[T,onlytextwidth]
      \begin{column}{0.53\textwidth}
        Let \(K(t)\) be a continuous-time Markov birth-death process with
        birth rate \(b(t)\) and death rate \(d(t)\).
        \pause
        
        \medskip
        \tiny
        Thus, writing \quad
        \(\Delta K(t) \coloneq K(t+\Delta t)-K(t)\), \pause
        \begin{equation*}\label{eq:kendall-transition-probabilities}
          \begin{aligned}
            \prob\{\Delta K(t)=+1\}
            &\;=\; b(t)K(t)\Delta t+o(\Delta t),\\
            \prob\{\Delta K(t)=-1\}
            &\;=\; d(t)K(t)\Delta t+o(\Delta t).
          \end{aligned}
        \end{equation*}
      \end{column}
      
      \begin{column}{0.4\textwidth}
        \centering
        \includegraphics[width=0.9\textwidth]{birth_death_process.png}
      \end{column}
    \end{columns}
    
  %%Define %%the ``discounted death pressure''
  %% weighted harmonic mean
  %%\begin{equation*}\label{eq:kendall-integral-A}
  Define \qquad
  $\displaystyle
  \INTEGRAL
  \;\coloneq\;
  \int_0^\infty \frac {d(t)} {e^{\int_0^t [b(t')-d(t')]\,\dee t'}} \,\dee t
  $ \ 
  %%\end{equation*}

  \smallskip
  Then the probability of extinction in finite time, \pause
  starting from \(K(0)=1\), \pause
  is
  \begin{equation*}\label{eq:kendall-extinction-probability}
    q\;=\;\frac{\INTEGRAL}{1+\INTEGRAL}.
  \end{equation*}
  %%If \(A\) diverges, \(q=1\).
  \pause
  If the process does not go extinct, it grows indefinitely.
  \pause
  With \(K(0)=m\), independent lineages give extinction probability \(q^m\).
  \end{theorem}

  \pause
  \emphblue{Homogeneous case:}

  \vspace{-\smallskipamount}
  If $b$ and $d$ are constant, then \ $\INTEGRAL=\dfrac{d}{b-d}$ \ and \ $q=\dfrac{d}{b}$.
\end{frame}

\begin{frame}
  \frametitle{\bfseries Fizzle: extinction before a first major outbreak}

  At introduction, the susceptible proportion $X(0)\approx1$, so an
  infectious lineage is approximately a homogeneous birth-death process:
  \begin{equation*}\label{eq:fizzle-main-rates}
    b\;=\;\beta,
    \qquad
    d\;=\;\gamma+\mu
  \end{equation*}

  \pause
  For one introduced infectious individual, the homogeneous case of
  \hyperlink{thm:Kendall}{Kendall's theorem} yields
  \begin{equation*}\label{eq:fizzle-main-one}
  \prob\{\text{fizzle}\} \;\approx\; \frac{d}{b} \;=\; \frac{1}{\Rn}
  \end{equation*}

  \pause
  For \(k\) introduced infectious individuals,
  \begin{equation*}\label{eq:fizzle-main-k}
    \begin{aligned}
  \prob\{\text{fizzle}\} \;&\approx\; \left(\frac{1}{\Rn}\right)^k
  \\ \pause
  \prob\{\text{not fizzle}\}
  \;&\approx\;
  1-\left(\frac{1}{\Rn}\right)^k
  \;\equiv\;
  p_k
  \end{aligned}
  \end{equation*}
\end{frame}

\begin{frame}
  \frametitle{\bfseries Burnout: extinction after major outbreak}

  \footnotesize

  When infection is rare, the susceptible proportion $X(t)$ changes mainly by
  demographic replenishment:
  \begin{equation*}\label{eq:susceptible-replenishment}
    \begin{aligned}
    \ddtau{X} \;&=\;\epsref(1-X)-\Rn XY \;\approx\; \epsref(1-X), \qquad X(0)=\xinref \\[5pt]
\implies\quad  X(t) \;&\approx\; 1-(1-\xinref)e^{-\mu t}
    \end{aligned}
  \end{equation*}
  \pause
  One infectious lineage then has time-dependent rates
  \begin{equation*}\label{eq:trough-birth-death-rates}
  b(t)\;=\;\beta\,X(t),
  \qquad
  d(t)\;=\;\gamma+\mu.
  \end{equation*}

  \pause

  \hyperlink{thm:Kendall}{Kendall's theorem} converts
  these rates into
  \begin{equation*}\label{eq:q-epi-context}
    q \;=\; \frac{\INTEGRAL}{1+\INTEGRAL} \;=\;
    \prob\left\{
    \parbox{6cm}{a single infectious lineage goes extinct before susceptible recruitment rescues transmission}
    \right\}
  \end{equation*}
  \pause
  Using Laplace's approximation, we find
  \begin{equation*}\label{eq:burnout-B}
    \INTEGRAL
    \;\approx\;
  \text{\tiny$
  \sqrt{\frac{2\pi}{\epsref(\Rn-1)}}\,
  \left(\frac{a}{z}\right)^a e^{z-a}$},
  \qquad
  z\;=\;
  \text{\tiny$
  \frac{\Rn}{\epsref}(1-\xinref)$},
  \qquad
  a\;=\;
  \text{\tiny$
  \frac{\Rn}{\epsref}(1-\hyperlink{eq:sir-endemic-equilibrium}{\xstar})$}
  \end{equation*}
  
  \footnotesize
  \pause Then the \term{conditional burnout probability} (conditional on not fizzling) is
  \begin{equation*}\label{eq:burnout-given-not-fizzle}
        \prob\{\text{burnout} \mid \text{not fizzle}\} \;\approx\; q^{n\ystarref}
  \end{equation*}
  \pause
  since \;$n\ystarref$\, is the expected number of infectives entering the \hyperlink{eq:xin}{boundary layer}.

\end{frame}

\begin{frame}
  \frametitle{\bfseries Persistence: persist beyond first wave}

  \pause
  If \(k\) infectives are introduced:
  \begin{equation*}\label{eq:all-probs}
    \begin{aligned}
      \prob\{\text{fizzle}\} \;&\approx\; \left(\frac{1}{\Rn}\right)^k
      \\ \pause
      \prob\{\text{not fizzle}\}
      \;&\approx\;
      1-\left(\frac{1}{\Rn}\right)^k
      \quad\;\equiv\;
      p_k
      \\[15pt] \pause
      \prob\{\text{burnout}\} \;&\approx\; p_k \, q^{n\ystarref}
      \qquad\qquad
      \left( \hyperlink{eq:q-epi-context}{q = \frac{\INTEGRAL}{1+\INTEGRAL}} \right)
      \\[15pt] \pause
      %% persist beyond first wave
      \prob\{\text{persist}\} \;&\approx\; 
      p_k\left(1-q^{n\ystarref}\right)
      \quad\;\equiv\;
      \Ppersist_1(\Rn,\epsref,n,k)
    \end{aligned}
  \end{equation*}

  \pause
  \bigskip
  \emphblue{\underline{Note}:}
  %% see PNAS eqs [28],[29] for \Ppersist_m(\Rn,\epsref,n,k), which involves \xinj rather than \xin
  The probability of persisting beyond $m$ waves, $\Ppersist_m(\Rn,\epsref,n,k)$, is barely less than
  $\Ppersist_1(\Rn,\epsref,n,k)$
  \pause\\
  (because subsequent troughs are much shallower).

\end{frame}

\begin{frame}
  \frametitle{Analytical \(\Ppersist_1\) formula agrees with simulations}

  \footnotesize
  \pause
  \bigskip
  Persistence probability \(\Ppersist_1\) is easy to estimate by ``brute force'':\pause\\
  run many stochastic epidemic simulations and count extinctions.
  
  \bigskip
  \begin{center}

  \emphblue{\hspace{1.5cm}Vertical scale linear \hspace{1.5cm} Vertical scale logarithmic}

  \includegraphics[width=0.95\textwidth,height=0.72\textheight,keepaspectratio]{persistence_vs_r0_minus_1.pdf}

  \hspace{1cm}$\Rn-1$\hspace{4cm}$\Rn-1$ 

  %%\pause Agreement between brute force and analytical estimation is excellent:

  %%\vspace{1em}\textbf{\color{gray}Grey}: stochastic simulations.  \qquad \textbf{Black}: analytical approximation.

  \end{center}

  \pause\medskip
  Using the analytical approximation for \(\Ppersist_1\):
  \begin{itemize}
    \pause\item reduces days or weeks of simulations to seconds
    \pause\item avoids trouble estimating small probabilities
    \pause\item makes parameter-space maps practical
    \pause\item reveals $\min(\Ppersist_1)$ occurs for \quad $\Rn \approx 2.57 - 27.7\epsref$
  \end{itemize}

\end{frame}

\section{Consequences}

\begin{frame}
  \frametitle{\bfseries Analytically calculated parameter space map}

  \begin{columns}[T,onlytextwidth]
    \begin{column}{0.68\textwidth}
      \centering
      \includegraphics[
        width=\textwidth,
        height=0.78\textheight,
        keepaspectratio
      ]{sir_persistence_contour_eta_0.pdf}
    \end{column}

    \begin{column}{0.30\textwidth}
      \pause
      \bigskip
      \footnotesize
      \emphblue{For SIR model with vital dynamics, without decay of immunity:}
      \begin{itemize}
        \pause\item minimum in \(\Ppersist_1\) \(\implies\) pathogens that are very weakly or very strongly transmissible are the most likely to persist
        \pause\item persistence typically requires very long infectious periods
      \end{itemize}
    \end{column}
  \end{columns}
\end{frame}


\begin{frame}
  \frametitle{\bfseries SIR verdict}

  \pause
  \emphblue{Based on the standard SIR model with births and deaths:}

  \bigskip

  \begin{itemize}\itemsep\bigskipamount
    \pause\item burnout is likely for most pathogens in human populations

    \pause\item for typical acute immunizing infections, susceptible recruitment alone is not enough to explain persistence

    \pause\item next obvious generalization is the SIRS model\pause, in which immunity is not permanent \dots
  \end{itemize}

  %%\pause This is not a claim that persistence is impossible; it says the simple SIR mechanism is insufficient.
\end{frame}

\begin{frame}
  \frametitle{\bfseries Waning immunity promotes persistence}

  \begin{columns}[T,onlytextwidth]
    \begin{column}{0.49\textwidth}
      \centering

      \textbf{SIR: permanent immunity}

      \emphblue{\footnotesize $\Timm = \infty$}

      \includegraphics[width=\textwidth,height=0.67\textheight,keepaspectratio]{sir_persistence_contour_eta_0.pdf}

    \end{column}
    \begin{column}{0.49\textwidth}
      \centering

      \textbf{SIRS: waning immunity}

      \emphblue{\footnotesize $\Timm = 100\times\Tinf$}

      \includegraphics[width=\textwidth,height=0.67\textheight,keepaspectratio]{sirs_persistence_contour_eta_0_01.pdf}

    \end{column}
  \end{columns}

  \pause
  \footnotesize
  \begin{itemize}
    \pause\item For a one-week infectious period, right panel has expected duration of immunity $\sim2$ years
    \pause\item SIRS model seems sufficient to explain persistence of SARS-CoV-2
  \end{itemize}

\end{frame}

\begin{frame}
  \frametitle{\bfseries SARS-CoV-2 persistence probability}

  \pause
  \bigskip
  \emphblue{SIRS model assumes:}
  \begin{itemize}
    \pause\item immune waning
    \pause\item no control
    \pause\item no behavioural change
    %% burnout after successful invasion is predicted to be negligible.
  \end{itemize}

  \begin{center}
    \emphblue{\qquad\footnotesize one-week generation interval \quad\qquad three-week generation interval}
    
    \includegraphics[width=0.94\textwidth,height=0.70\textheight,keepaspectratio]{sars_cov_2_eta_effect.pdf}
  \end{center}

  \emphblue{Implications for SARS-CoV-2 persistence:}
  \begin{itemize}
    %%\pause\item Given estimated SARS-CoV-2 generation intervals and immune periods, it was almost certain to persist after not fizzling
    \pause\item Given that SARS-CoV-2 did \emph{not} fizzle, and the mean immune period is short, the probability that it would have burnt out if allowed to spread without control was negligible.
  \end{itemize}
  
\end{frame}

\begin{frame}
  \frametitle{\bfseries Persistence of childhood infections like measles remains puzzling}

\parskip=\bigskipamount

\pause
Persistence of measles and many other infectious diseases with
permanent or near-permanent immunity cannot be explained by the SIR or
SIRS models.

\pause
Mechanisms other than homogeneous mixing and decay of immunity must
play a role.  \pause \emphblue{Perhaps:}

\begin{itemize}
\pause\item Multiple introductions into the host population\\
  {\tiny(\eg {Keeling \& Gilligan 2000}, {Pulliam \emph{et al.} 2007})} %% ~\cite{Pull+07}, %KeelGill00,
\pause\item Spatial spread among cities promoting global persistence in spite of local fadeouts\\
  {\tiny(\eg {Dobson \& Carper 1996}, {Cross \emph{et al.} 2006})} %%~\cite{Cros+06}, %DopsCarp96, 
  \pause\item Invasion with low $\R_0$ followed by evolution to higher $\R_0$\\
  {\tiny(\eg {Antia \emph{et al.} 2003})} %%~\cite{Anti+03}.
\end{itemize}

\end{frame}

\begin{frame}
  \frametitle{\bfseries Take-Home}

  \begin{enumerate}\itemsep10pt
    \pause
   \item Fizzle and burnout are distinct extinction events.
    \pause
    \item Burnout is governed by rare infectious lineages in the
      post-epidemic trough.
    \pause
    \item Kendall's theorem plus deterministic epidemic geometry yields a
      direct analytical approximation for SIR and SIRS burnout probability.
    \pause
    \item New analytical expressions faciliate detailed exploration of
      persistence probability in parameter space.
    \pause
    \item Births alone are often insufficient, but immune waning can be
      sufficient, as in the SARS-CoV-2 example.
    \pause
    \item Persistence of measles and other acute, immunizing
      infections remains a key puzzle.
  \end{enumerate}
\end{frame}


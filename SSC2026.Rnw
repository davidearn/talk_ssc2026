<<flu.settings, echo=FALSE>>=
beamerblue <- rgb(50, 56, 176, max=255)
@ 

<<pop.interp.fun, echo=FALSE>>=
##' @param pop data frame
##' @param year year to interpolate to
pop_interp <- function( pop, year ) {
    slope <- (pop[2,2] - pop[1,2])/(pop[2,1] - pop[1,1])
    out <- round( pop[1,2] + (year-pop[1,1])*slope )
    return(out)
}
@ 

<<londonpop, echo=FALSE>>=
## https://en.wikipedia.org/wiki/Demography_of_London
londonpop <- data.frame(year = c(1911,1921), population = c(7157875, 7553526))
londonpop1918 <- pop_interp( londonpop, 1918 )
@ 


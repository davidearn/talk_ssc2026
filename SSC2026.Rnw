\end{frame}

\begin{frame}
  \frametitle{Three Early Outcomes}

  \begin{description}
    \item[Fizzle] stochastic extinction before a major epidemic.
    \pause
    \item[Burnout] stochastic extinction after a major epidemic, near the
      post-epidemic trough.
    \pause
    \item[Persistence] the pathogen escapes both events and produces later
      epidemic waves.
  \end{description}

  \vspace{1.2em}
  In a finite stochastic model, eventual extinction is certain; here
  \term{persistence} means survival past the first major trough.
\end{frame}

\section{The SIR model}

\begin{frame}
  \frametitle{Susceptible-Infectious-Removed (SIR) model
    \quad \parbox{10ex}{\raggedright\tiny\color{cyan} Kermack and McKendrick (1927)}
  }

  %%\leftline{\tiny\color{cyan} Kermack and McKendrick 1927 (KM27)}

  \pause
  \begin{center}
  %%\includegraphics[width=0.9\textwidth]{flowcharts/flowrates.pdf}
  %%\includegraphics[width=0.9\textwidth]{images/SIR_flow_colour.pdf}
  %%\includegraphics[width=\textwidth]{images/SIRflowchart_nogreek.png}
  \includegraphics[width=0.8\textwidth]{sir_flowchart.png}
  \end{center}

  \pause
  %%\makebox[\textwidth][c]{%
  %%Ordinary differential equations (ODEs):
  \begin{equation*}
  \text{\color{beamerblue}ODEs:} \quad
    \ddt{S} \;=\; - \beta S I \qquad\quad
    \ddt{I} \;=\; \beta S I - \gamma I  \qquad\quad
    \ddt{R} \;=\; \gamma I
  \quad \phantom{\text{ODEs:}}
  \end{equation*}
  %%}
  \vspace{-10pt}
  \pause
  %%Initial conditions:
  \begin{equation*}
    %%\phantom{-S}
    S(\tinit) \;=\; \sinit \qquad\qquad\
    I(\tinit) \;=\; \iinit \qquad\qquad\quad
    R(\tinit) \;=\; \rinit
  \end{equation*}

  \bigskip
  \pause
  \emphblue{Notational convention:}
  \begin{itemize}
    \pause\item UPPER CASE (\eg $S$, $I$) $\implies$ functions
    \pause\item lower case (\eg $t$, $\sinit$, $\iinit$) $\implies$
    independent variables and values of functions at specific points
  \end{itemize}

  \medskip
  \pause
  \emphblue{Parameters:}
  \begin{itemize}
  \pause\item
  {Transmission rate:} \ $\beta$
  \pause\item
  {Recovery rate:} \ $\gamma$
  \pause \qquad\qquad
  ($\frac{1}{\gamma} = \text{mean infectious period}$)
  \end{itemize}

\end{frame}

\begin{frame}
  \frametitle{\textbf{SIR model:} in dimensionless, proportional form}

  \small
  \begin{itemize}\itemsep3pt
    \pause\item Total population: $\Npop = S + I + R$

    \pause\item State variables:
    \begin{itemize}\itemsep3pt
      \pause\item \emphblue{Susceptible fraction:} \ \ \ $X = S/\Npop$
      \pause\item \emphblue{Prevalence of infection:}  \ $Y = I/\Npop$
    \end{itemize}

  \pause\item Dimensionless parameter: \emphblue{Basic reproduction number:} \;$\Rn = \dfrac{\beta}{\gamma}$
  \pause
  $\Big(\parbox{10ex}{\centering\scriptsize transmission rate}\Big)
  \times \Big(\parbox{8ex}{\centering\scriptsize mean infectious period}\Big)
  \pause = \; \Big(\parbox{31ex}{\centering\scriptsize number of infections expected to be caused by a single infectious individual in a wholly susceptible population}\Big)$

  \pause\item Dimensionless time unit:
  \begin{itemize}
  \pause\item
  \emphblue{Time in units of mean infectious period:} \ $\tau = \gamma t$
  \end{itemize}

  \end{itemize}

  \pause
  \begin{equation*}
    \begin{aligned}
      \ddtau{X} &\;=\; - \Rn X Y,        & \qquad X(\tauinit) \;=\; \xinit \\
      \noalign{\vspace{5pt}}
      \ddtau{Y} &\;=\; (\Rn X  - 1) Y,   & \qquad Y(\tauinit) \;=\; \yinit
    \end{aligned}
  \end{equation*}

  \begin{itemize}
    \pause\item \emphblue{Peak prevalence:} \ max $Y(\tau) $ \
    occurs when \ $X(\tau)=\dfrac{1}{\Rn}\equiv\xpeak$
  \end{itemize}

  \only<.>{\hypertarget{eq:SIR}{}}

\end{frame}

\begin{frame}
  \frametitle{\textbf{SIR model:} Typical (numerical) solution\hfill\break for susceptibles $X(\tau)$ and prevalence of infection $Y(\tau)$}

  \begin{center}

    \includegraphics[width=\textwidth]{mbrs_sir_timeseries.pdf}

    \bigskip
    Time $\tau$ measured in units of mean infectious period ($\frac{1}{\gamma}$)

  \end{center}

  \hypertarget{sir.short}{}
\end{frame}

\begin{frame}
  \frametitle{\textbf{SIR model:} \ $x$-$y$ phase plane}

  \begin{itemize}\itemsep10pt

    \pause\item No closed-form analytical solution of
    \myhyperlink{eq:SIR}{SIR model} for
    %% time series of
    susceptible proportion $X(\tau)$ and prevalence of infection
    $Y(\tau)$

    \pause\item But the \emphblue{exact solution in $x$-$y$ phase plane} is easily found:

    \smallskip
    \begin{itemize}

      \pause\item Consider \emphblue{ratio of rates} of change of $Y$ and $X$:
      \pause
      \begin{equation*}
        \frac{\dee Y / \dee\tau}{\dee X/\dee\tau}
        \pause \;=\; \frac{\Rn X Y - Y}{-\Rn X Y}
        \pause \;=\; -1 + \frac{1}{\Rn X}
      \end{equation*}

      \pause\item Obtain simple \emphblue{separable ODE} for $Y(x)$:
      \begin{equation*}
        \ddx{Y} \;=\; -1 + \frac{\xpeak}{x} \,,
        \qquad Y(\xinit) \;=\; \yinit
      \end{equation*}
      \pause
      {\footnotesize\hfill
\        ($\xpeak \,=\, \frac{1}{\Rn} \,=\, X(\tau)\text{ at peak prevalence}$)}

      \bigskip
      \pause\item \emphblue{Exact solution for phase portrait} is
      \begin{equation*}
        Y(x) \;=\; \yinit + (\xinit - x) - \xpeak\log{\frac{\xinit}{x}} \,,
      \end{equation*}

    \end{itemize}
  \end{itemize}
  \pause
  \frameendtarget{eq:dYdx}
  \frameendtarget{eq:Yofx}
\end{frame}

\begin{frame}
  \frametitle{\textbf{SIR model:} \ Exact $x$-$y$ phase portrait \,$Y(x)$}

  \begin{center}
    \includegraphics[width=0.75\textwidth]{mbrs_sir_phase_portrait.pdf}
  \end{center}

  \hypertarget{fig:pp}{}

\end{frame}

\begin{frame}
  \frametitle{SIR With Vital Dynamics}

  Counts are natural for the epidemic model:
  \begin{equation*}\label{eq:sir-counts}
  \begin{aligned}
  \ddt{S} &\;=\; \mu n - \beta\frac{S I}{n} - \mu S,\\
  \ddt{I} &\;=\; \beta\frac{S I}{n} -(\gamma+\mu)I,\\
  \ddt{R} &\;=\; \gamma I - \mu R.
  \end{aligned}
  \end{equation*}

  \pause
  \begin{equation*}\label{eq:r0-epsilon-defs}
  \Rn\;=\;\frac{\beta}{\gamma+\mu},
  \qquad
  \eps\;=\;\frac{\mu}{\gamma+\mu}
  \;=\;
  \frac{\text{mean infectious period}}{\text{mean lifetime}}.
  \end{equation*}

  \vspace{0.4em}
  For acute human infections, \(\eps\) is small.
\end{frame}

\begin{frame}
  \frametitle{Counts and Proportions}

  For phase-plane geometry and the formula, use proportions:
  \begin{equation*}\label{eq:proportion-defs}
  X\;=\;\frac{S}{n},\qquad
  Y\;=\;\frac{I}{n},\qquad
  Z\;=\;\frac{R}{n}.
  \end{equation*}

  With time scaled by \(\gamma+\mu\),
  \begin{equation*}\label{eq:sir-proportion-odes}
  \ddtau{X}\;=\;\eps(1-X)-\Rn XY,
  \qquad
  \ddtau{Y}\;=\;(\Rn X-1)Y.
  \end{equation*}

  \pause
  If \(\Rn>1\), the deterministic endemic equilibrium is
  \begin{equation*}\label{eq:sir-endemic-equilibrium}
  (\xstar,\ystar)
  \;=\;
  \left(\frac{1}{\Rn},\eps\left(1-\frac{1}{\Rn}\right)\right).
  \end{equation*}

  \pause
  But in a finite population, \(nY(t)\) is the expected number infectious.
\end{frame}

\begin{frame}
  \frametitle{Individual-Based Stochastic SIR}

  The same model can be interpreted as a continuous-time Markov chain:

  \begin{center}
  \small
  \begin{tabular}{lll}
    Event & Jump & Rate\\
    \hline
    Infection & \((S,I,R)\to(S-1,I+1,R)\) &
      \(\beta S I/\Npop\)\\
    Recovery & \((S,I,R)\to(S,I-1,R+1)\) &
      \(\gamma I\)\\
    Death, susceptible & \((S,I,R)\to(S,I,R)\) &
      \(\mu S\)\\
    Death, infectious & \((S,I,R)\to(S+1,I-1,R)\) &
      \(\mu I\)\\
    Death, removed & \((S,I,R)\to(S+1,I,R-1)\) &
      \(\mu R\)
  \end{tabular}
  \end{center}

  \pause
  States are discrete counts, so extinction is a boundary event.
\end{frame}

\begin{frame}
  \frametitle{Stochastic Trajectories Can Hit the Boundary}

  \centering
  \includegraphics[width=0.82\textwidth,height=0.72\textheight,keepaspectratio]{todd_stochastic_sir_trajectory.pdf}

  \vspace{0.2em}
  Deterministic geometry still matters, but rare infection needs a stochastic
  approximation.
\end{frame}

\begin{frame}
  \frametitle{The Deterministic Picture Is Not Enough}

  \centering
  \includegraphics[width=0.94\textwidth,height=0.73\textheight,keepaspectratio]{sir_ts_long.pdf}

  \vspace{0.2em}
  A deterministic trajectory can pass through troughs where \(nY(t)\)
  is near one.
\end{frame}

\begin{frame}
  \frametitle{The Dangerous Trough}

  \begin{columns}[T,onlytextwidth]
    \begin{column}{0.49\textwidth}
      \centering
      \includegraphics[width=\textwidth,height=0.68\textheight,keepaspectratio]{sir_trough_slow_infectious_period.pdf}

      Longer infectious period
    \end{column}
    \begin{column}{0.49\textwidth}
      \centering
      \includegraphics[width=\textwidth,height=0.68\textheight,keepaspectratio]{sir_trough_fast_infectious_period.pdf}

      Shorter infectious period
    \end{column}
  \end{columns}

  \vspace{0.3em}
  Susceptible recruitment helps, but the depth and timing of the trough
  determine the extinction risk.
\end{frame}

\section{Burnout Probability}

\begin{frame}
  \frametitle{Hybrid Deterministic-Stochastic Idea}

  \begin{columns}[c,onlytextwidth]
    \begin{column}{0.55\textwidth}
      \includegraphics[width=\textwidth,height=0.72\textheight,keepaspectratio]{boundary_layer_phase_plane.pdf}
    \end{column}
    \begin{column}{0.42\textwidth}
      \begin{enumerate}
        \item Follow the deterministic SIR trajectory while infection is
          common.
        \pause
        \item Enter a boundary layer when infection is rare.
        \pause
        \item Approximate the number infectious by a time-inhomogeneous
          birth-death process.
      \end{enumerate}

      \vspace{0.6em}
      The phase-plane calculation supplies the entry point \(\xin\).
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}
  \frametitle{Birth-Death Approximation Near the Boundary}

  \begin{columns}[c,onlytextwidth]
    \begin{column}{0.37\textwidth}
      \centering
      \includegraphics[width=0.95\textwidth]{birth_death_process.png}
    \end{column}
    \begin{column}{0.58\textwidth}
      When infectious hosts are rare, susceptible hosts are nearly
      deterministic.

      \pause
      Infectious hosts behave approximately as independent lineages:
      \begin{equation*}\label{eq:rare-infection-lineage-rates}
      b(t)\;=\;\beta X(t),\qquad
      d(t)\;=\;\gamma+\mu.
      \end{equation*}

      \pause
      Kendall's theorem gives the extinction probability for each lineage.
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}
  \frametitle{Kendall's Birth-Death Result}

  \small
  \begin{theorem}[Kendall, 1948]
  Let \(K(t)\) be a continuous-time Markov birth-death process with
  \begin{equation*}\label{eq:kendall-transition-probabilities}
  \begin{aligned}
  \prob\{K(t+\Delta t)\;=\;K(t)+1\}
  &\;=\; b(t)K(t)\Delta t+o(\Delta t),\\
  \prob\{K(t+\Delta t)\;=\;K(t)-1\}
  &\;=\; d(t)K(t)\Delta t+o(\Delta t).
  \end{aligned}
  \end{equation*}
  If \(K(0)=1\), define
  \begin{equation*}\label{eq:kendall-integral-A}
  A
  \;=\;
  \int_0^\infty
  e^{\int_0^s [d(u)-b(u)]\,\dee u} d(s)\,\dee s.
  \end{equation*}
  Then the probability of extinction in finite time is
  \begin{equation*}\label{eq:kendall-extinction-probability}
  q\;=\;\frac{A}{1+A}.
  \end{equation*}
  If \(A\) diverges, \(q=1\).  If the process does not go extinct, it
  grows indefinitely.
  \end{theorem}

  \pause
  With \(K(0)=m\), independent lineages give extinction probability \(q^m\).
\end{frame}

\begin{frame}
  \frametitle{Fizzle: Extinction Before the First Epidemic}

  At introduction, the susceptible proportion is nearly one, so one
  infectious lineage is approximately a homogeneous birth-death process:
  \begin{equation*}\label{eq:fizzle-main-rates}
  b\;=\;\beta,\qquad
  d\;=\;\gamma+\mu.
  \end{equation*}

  \pause
  For one introduced infectious individual,
  \begin{equation*}\label{eq:fizzle-main-one}
  \prob\{\text{fizzle}\}\approx \frac{1}{\Rn}.
  \end{equation*}

  \pause
  For \(k\) introduced infectious individuals,
  \begin{equation*}\label{eq:fizzle-main-k}
  \prob\{\text{fizzle}\}\approx \left(\frac{1}{\Rn}\right)^k,
  \qquad
  p_k\;=\;\prob\{\text{not fizzle}\}
  \;=\;
  1-\left(\frac{1}{\Rn}\right)^k.
  \end{equation*}
\end{frame}

\begin{frame}
  \frametitle{Birth and Death Rates in the Trough}

  When infection is rare, the susceptible proportion changes mainly by
  demographic replenishment:
  \begin{equation*}\label{eq:susceptible-replenishment}
  X(t) \approx 1-(1-\xin)e^{-\mu t}.
  \end{equation*}

  \pause
  One infectious lineage then has time-dependent rates
  \begin{equation*}\label{eq:trough-birth-death-rates}
  b(t)\;=\;\beta X(t),
  \qquad
  d(t)\;=\;\gamma+\mu.
  \end{equation*}

  \pause
  Kendall's theorem converts these rates into the probability that a
  single infectious lineage goes extinct before susceptible recruitment
  rescues transmission.
\end{frame}

\begin{frame}
  \frametitle{Entry Into the Rare-Infection Layer}

  Use the deterministic phase-plane trajectory until infectious hosts become
  rare:
  \begin{equation*}\label{eq:main-boundary-layer-entry}
  Y\;=\;\ystar\;=\;\eps\left(1-\frac{1}{\Rn}\right),
  \qquad
  X\;=\;\xin.
  \end{equation*}

  \pause
  The phase-plane asymptotics give \(\xin\) directly.  To first useful order,
  \begin{equation*}\label{eq:main-xin-phase-plane}
  \xin
  \;=\;
  e^{-\Rn(1-\ystar)}
  + \eps e^{\Rn\ystar}
  \log\left(\frac{\ystar}{Y_{\max}}\right)
  + \Oh(\eps^2).
  \end{equation*}

  \pause
  This is the deterministic input to the stochastic burnout calculation.
\end{frame}

\begin{frame}
  \frametitle{A Direct Burnout Approximation}

  % TODO: Recheck the visible notation and transcription against Pars et al.
  % (2024), the poster formula block, and David's preferred convention before
  % using this as the final slide version.
  With
  \begin{equation*}\label{eq:burnout-za}
  z\;=\;\frac{\Rn}{\eps}(1-\xin),
  \qquad
  a\;=\;\frac{\Rn}{\eps}(1-\xstar),
  \end{equation*}
  define
  \begin{equation*}\label{eq:burnout-B}
  B \;=\;
  \sqrt{\frac{2\pi}{\eps(\Rn-1)}}\,
  \left(\frac{a}{z}\right)^a e^{z-a}.
  \end{equation*}
  The per-lineage burnout probability after the first epidemic is
  \begin{equation*}\label{eq:burnout-lineage-q}
  q \approx \left(1+\frac{1}{B}\right)^{-1}.
  \end{equation*}

  \pause
  If \(k\) infectives are introduced,
  \begin{equation*}\label{eq:first-wave-persistence-probability}
  p_k \;=\; 1-\left(\frac{1}{\Rn}\right)^k,
  \qquad
  \Ppersist_1(\Rn,\eps,n,k)
  \;=\;
  p_k\left(1-q^{n\ystar}\right).
  \end{equation*}
\end{frame}

\begin{frame}
  \frametitle{What Is New Computationally?}

  Burnout probability has always been estimable by simulation.

  \pause
  The change is that \(\Ppersist_1\) is now a direct analytical
  approximation.

  \pause
  \vspace{1.0em}
  That turns a large brute-force simulation problem into a calculation
  that is essentially immediate, so parameter-space maps become practical.
\end{frame}

\begin{frame}
  \frametitle{Formula and Simulation Agree}

  \centering
  \includegraphics[width=0.95\textwidth,height=0.72\textheight,keepaspectratio]{persistence_vs_r0_minus_1.pdf}

  \vspace{0.3em}
  Grey: stochastic simulations. Black: analytical approximation.
\end{frame}

\section{Consequences}

\begin{frame}
  \frametitle{Persistence Can Be Bimodal}

  The direct expression gives qualitative structure that is hard to see by
  brute-force simulation.

  \pause
  \begin{itemize}
    \item Persistence probability can be bimodal as a function of \(\Rn\).
    \pause
    \item The minimum occurs near
      \begin{equation*}\label{eq:persistence-minimum-r0}
      \Rn \approx 2.57 - 27.7\eps.
      \end{equation*}
    \pause
    \item For a pathogen, both very low and very high transmissibility can be
      more favourable to persistence than intermediate transmissibility.
  \end{itemize}
\end{frame}

\begin{frame}
  \frametitle{Analytical expressions make parameter space maps possible}

  \centering
  \includegraphics[width=0.96\textwidth,height=0.72\textheight,keepaspectratio]{sir_persistence_contour_eta_0.pdf}

  \vspace{0.3em}
  For SIR, susceptible recruitment alone often predicts burnout in
  plausible human population sizes.
\end{frame}

\begin{frame}
  \frametitle{SIR Verdict}

  In the homogeneous SIR model with births and deaths:

  \begin{itemize}
    \item high \(\Rn\) helps transmission, but also depletes susceptibles
      deeply;
    \pause
    \item longer infectious periods make persistence easier;
    \pause
    \item for many acute immunizing infections, susceptible recruitment
      alone is not enough.
  \end{itemize}

  \pause
  This is not a claim that persistence is impossible; it says the simple
  SIR mechanism is insufficient.
\end{frame}

\begin{frame}
  \frametitle{What Immune Waning Changes}

  \begin{columns}[T,onlytextwidth]
    \begin{column}{0.49\textwidth}
      \centering
      \includegraphics[width=\textwidth,height=0.67\textheight,keepaspectratio]{sir_persistence_contour_eta_0.pdf}

      SIR: permanent immunity
    \end{column}
    \begin{column}{0.49\textwidth}
      \centering
      \includegraphics[width=\textwidth,height=0.67\textheight,keepaspectratio]{sirs_persistence_contour_eta_0_01.pdf}

      SIRS: waning immunity
    \end{column}
  \end{columns}

  \vspace{0.3em}
  If immunity wanes on the scale of years,\\
  the same calculation can predict persistence rather than burnout.
\end{frame}

\begin{frame}
  \frametitle{SARS-CoV-2}

  \centering
  \includegraphics[width=0.94\textwidth,height=0.70\textheight,keepaspectratio]{sars_cov_2_eta_effect.pdf}

  \vspace{0.3em}
  In a model with immune waning and no sustained control or behavioural
  change, burnout after successful invasion is predicted to be negligible.
\end{frame}

\begin{frame}
  \frametitle{The Measles-Like Puzzle Remains}

  SIRS helps when immunity wanes quickly enough.

  \pause
  But measles-like infections have near-permanent immunity.

  \pause
  \vspace{0.8em}
  Mechanisms still to assess include:
  \begin{itemize}
    \item repeated introductions;
    \item spatial or metapopulation rescue;
    \item heterogeneity in mixing or susceptibility;
    \item antigenic evolution, reservoirs, or carrier states.
  \end{itemize}
\end{frame}

\begin{frame}
  \frametitle{Take-Home}

  \begin{enumerate}
    \item Fizzle and burnout are distinct extinction events.
    \pause
    \item Burnout is governed by rare infectious lineages in the
      post-epidemic trough.
    \pause
    \item Kendall's theorem plus deterministic epidemic geometry yields a
      direct analytical approximation for SIR and SIRS burnout probability.
    \pause
    \item Births alone are often insufficient, but immune waning can be
      sufficient, as in the SARS-CoV-2 example.
    \pause
    \item Measles-like persistence remains a key puzzle.
  \end{enumerate}
\end{frame}

